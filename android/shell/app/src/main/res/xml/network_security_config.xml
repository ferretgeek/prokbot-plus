<?xml version="1.0" encoding="utf-8"?>
<!-- A self-hosted Host is often a plain http:// LAN address, and the WebView only
     talks to the loopback gateway inside this app. User CAs allow private HTTPS Hosts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
